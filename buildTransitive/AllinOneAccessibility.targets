<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Copies this package's App_Plugins folder into the consuming Umbraco
    website on every build, so the backoffice dashboards, the settings page
    template and its assets are discovered and served from the site's
    physical App_Plugins folder (Umbraco reads package.manifest /
    umbraco-package.json from the content root only).

    The file name must match the NuGet package id exactly
    (buildTransitive/AllinOneAccessibility.targets), or NuGet will not
    import it.
  -->

  <PropertyGroup>
    <AioaAppPluginsSource>$(MSBuildThisFileDirectory)..\App_Plugins\</AioaAppPluginsSource>
  </PropertyGroup>

  <Target Name="CopyAllinOneAccessibilityAppPlugins" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <AioaAppPluginsFiles Include="$(AioaAppPluginsSource)**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(AioaAppPluginsFiles)"
      DestinationFiles="@(AioaAppPluginsFiles->'$(MSBuildProjectDirectory)\App_Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(AioaAppPluginsFiles)' != ''" />
  </Target>

</Project>
